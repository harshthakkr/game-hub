# Application URL (for server-side API calls)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IGDB API
NEXT_PUBLIC_BASE_URL="https://api.igdb.com/v4"
NEXT_PUBLIC_CLIENT_ID="your_igdb_client_id"
NEXT_PUBLIC_CLIENT_SECRET="your_igdb_client_secret"

# NextAuth.js (Google OAuth)
AUTH_SECRET="your_auth_secret"
AUTH_GOOGLE_ID="your_google_client_id"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# Gemini API
GEMINI_API_KEY="your_gemini_api_key"  

# PostgreSQL (Prisma) — required for reviews, comments and accounts
DATABASE_URL="postgresql://user:password@localhost:5432/gamehub?schema=public"

# Optional: guards /api/cron/prices, a manual short price refresh. (The
# scheduled sweep runs as a script in GitHub Actions and doesn't use it.)
CRON_SECRET="a_long_random_string"

# Auth.js trusts the host automatically on Vercel. For `next start` anywhere
# else (including local production builds), set this so sessions work.
AUTH_TRUST_HOST=true
